# Public settings for the existing HTTPS lab; not a complete .env.
# Merge these settings into the private VM .env with an editor.
# Preserve DB/storage passwords, Clerk keys, allowlist and other existing values.
# Do not replace an existing .env with this file or source it as a shell script.
# Runtime pin verified 2026-10-22; do not replace it with the latest docs HEAD.
SECURITY_IMAGE=html-share-studio:share-dc7560ea1c34
APP_PORT=3100
GATEWAY_PORT=4100
AUTH_MODE=clerk
STUDIO_PUBLIC_ORIGIN=https://studio-lab.ods.vn
# Add only explicit loopback origins if retaining the operator SSH tunnel.
AUTH_TRUSTED_ORIGINS=https://studio-lab.ods.vn
VIEWER_PUBLIC_ORIGIN=https://view-lab.ods.vn
GATEWAY_MODE=hostname
PUBLIC_SITE_DOMAIN=lab-space-ods.cfvn.cloud
PUBLIC_SITE_SCHEME=https
# compose.security.yaml derives this from GATEWAY_PORT; the final HTTPS
# overlay must explicitly set PUBLIC_SITE_PORT: "" for both web and gateway.
PUBLIC_SITE_PORT=
GATEWAY_FRAME_SOURCE=https://*.lab-space-ods.cfvn.cloud
GATEWAY_RESERVED_HOSTS=www,mail,api,admin,studio,view
VIEWER_REQUESTS_PER_MINUTE=600
SHARE_LINK_MUTATIONS_ENABLED=true
# Keep existing Clerk keys in the private .env. The security overlay maps:
# GATEWAY_VIEWER_ORIGIN <- VIEWER_PUBLIC_ORIGIN
# GATEWAY_PREVIEW_ORIGIN <- STUDIO_PUBLIC_ORIGIN
# Current gateway deliberately remains security-417c50d. SECURITY_IMAGE
# selects all three services in compose.security.yaml: use web-only updates
# unless gateway migration has been reviewed. See docs/LAB_HANDOFF.md.
