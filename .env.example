# Local development values only. Copy to .env and change passwords before use.
# Existing HTTPS VM: merge deploy/lab-public.env.example settings using
# docs/LAB_HANDOFF.md; never overwrite its private .env with this file.
APP_PORT=3000
POSTGRES_USER=html_share
POSTGRES_DB=html_share
POSTGRES_PASSWORD=change-this-local-db-password
POSTGRES_PORT=5432
MINIO_ROOT_USER=local_admin
MINIO_ROOT_PASSWORD=change-this-local-minio-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Local-only prototype auth. Never expose this stack to the Internet.
LOCAL_DEMO_MODE=1
LOCAL_DEMO_PASSWORD=replace-with-a-long-random-local-password
LOCAL_DEMO_SESSION_SECRET=replace-with-a-separate-32-byte-random-secret
# Use APP_PORT=3100 and GATEWAY_PORT=4100 when P1 already occupies port 3000.
GATEWAY_PORT=4100
# Security overlay: set AUTH_MODE=clerk only after keys and DB allowlist are configured.
AUTH_MODE=local-demo
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
# Publishable key is intentionally public; SECRET_KEY is server-only.
CLERK_PUBLISHABLE_KEY=
# Standard Clerk name also accepted by the security overlay; CLERK_PUBLISHABLE_KEY takes precedence.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
GATEWAY_MODE=hostname
PUBLIC_SITE_DOMAIN=uploads.localhost
PUBLIC_SITE_SCHEME=http
VIEWER_PUBLIC_ORIGIN=
STUDIO_PUBLIC_ORIGIN=http://127.0.0.1:3100
GATEWAY_FRAME_SOURCE=http://*.uploads.localhost:4100
# Set the verified image tag before using compose.security.yaml.
SECURITY_IMAGE=
# Per-process viewer budget, not an edge per-IP/distributed limit.
VIEWER_REQUESTS_PER_MINUTE=600
# Operational kill switch; preserve share mapping/tombstones when disabled.
SHARE_LINK_MUTATIONS_ENABLED=true
