    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tldts": "^7.4.18",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.0",
    "miniflare": "5.20261019.2-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
